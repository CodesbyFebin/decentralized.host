# Copy to .env and adjust as needed. Defaults below are fine for local dev.

SECRET_KEY=dev-insecure-secret-change-me
NODE_JOIN_SECRET=dev-join-secret
DEPLOY_API_KEY=dev-deploy-key

BASE_DOMAIN=127.0.0.1.nip.io
HEARTBEAT_STALE_SECONDS=30
NODE_TOKEN_TTL_HOURS=24

# --- Automated failover (see app/failover.py) ---
# A node missing a heartbeat for this long (not just briefly stale) has its
# running deployments automatically rescheduled to another healthy node.
# Deliberately much bigger than HEARTBEAT_STALE_SECONDS: a node's Docker
# runtime restarting is a real, observed case that recovers on its own in
# under two minutes and shouldn't trigger a reschedule.
NODE_OFFLINE_SECONDS=180
# How often the background loop checks for offline nodes to reschedule.
FAILOVER_CHECK_INTERVAL_SECONDS=20

# --- Production only (docker-compose.prod.yml) ---
# Real domain deployments use BASE_DOMAIN for app subdomains and need an
# email for Let's Encrypt registration. See DEPLOY.md.
# BASE_DOMAIN=decentralized.host
# ACME_EMAIL=you@example.com

# --- Optional AI features (Dockerfile review, release notes, post-deploy
# health analysis, dhost engine agents -- see control-plane/app/llm.py) ---
# All fully optional and honestly gated: leave every one blank and those
# features just report "not configured" instead of faking a result.
# Set at most one, or several -- if several, the real order tried is
# Anthropic, then OpenAI, then Google, whichever key is actually set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# --- Node operator credits (Solana devnet) ---
# Leave ENABLE_BLOCKCHAIN=false until you've run:
#   pip install -r blockchain/requirements.txt
#   python blockchain/scripts/setup_devnet.py
# then paste the printed mint address below and flip this to true.
ENABLE_BLOCKCHAIN=false
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MINT_ADDRESS=
SOLANA_PAYER_KEYPAIR_PATH=/app/blockchain/.keys/payer.json
CREDITS_PER_REWARD=10
HEARTBEATS_PER_REWARD=6
