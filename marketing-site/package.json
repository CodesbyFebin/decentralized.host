{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "generate-machine-files": "tsx scripts/generate-machine-files.ts",
    "prerender": "start-server-and-test 'vite preview --port 4173' http://localhost:4173 'tsx scripts/prerender.ts'",
    "build": "npm run generate-sitemap && npm run generate-machine-files && vite build && (npm run prerender || echo 'Prerender failed -- falling back to client-side rendering for this deploy')",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^13.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.9.0",
    "puppeteer-core": "^25.9.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
